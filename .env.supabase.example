# ============================================================
# Supabase Edge Functions 环境变量模板
# 复制为 .env.supabase 并填写真实值（.env.supabase 已被 git 忽略）
#   cp .env.supabase.example .env.supabase
#
# 获取位置:
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY:
#     Supabase 控制台 → Project Settings → API
#   GEMINI_API_KEY:
#     https://aistudio.google.com/apikey
#   APPLE_*（可选，verify-transaction 二次校验）:
#     App Store Connect → 用户和访问 → 集成 → App Store Server API
# ============================================================

# 必填：所有函数
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 必填：parse-expense（AI 解析）
GEMINI_API_KEY=your-gemini-key

# 可选：verify-transaction（Apple App Store Server API 二次校验）
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_BUNDLE_ID=com.nsoft.huaji2046
