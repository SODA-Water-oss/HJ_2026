# ============================================================
# Supabase Edge Functions 环境变量模板
# 复制为 .env.supabase 并填写真实值（.env.supabase 已被 git 忽略）
#   cp .env.supabase.example .env.supabase
#
# 获取位置:
#   SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY:
#     Supabase 控制台 → Project Settings → API
#   GEMINI_API_KEY:
#     https://aistudio.google.com/apikey
# ============================================================

# 必填：所有函数
# SUPABASE_URL 由 Supabase 平台自动注入，无需在此设置
# SERVICE_ROLE_KEY 即控制台的 service_role key（注意：不能命名为 SUPABASE_ 开头，CLI 会拒绝）
SERVICE_ROLE_KEY=your-service-role-key

# 必填：parse-expense（AI 解析）
GEMINI_API_KEY=your-gemini-key

# 必填：spending-review（最近收支评价）
DEEPSEEK_API_KEY=your-deepseek-key
